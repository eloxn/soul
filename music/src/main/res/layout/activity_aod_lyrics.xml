<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aod_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Anti-Burn-In Shifting Container -->
    <LinearLayout
        android:id="@+id/aod_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Top Header: Ambient Clock & Battery Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextClock
                android:id="@+id/aod_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm a"
                android:format24Hour="HH:mm"
                android:textColor="#888888"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/aod_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="12sp"
                android:text="--%" />

            <ImageView
                android:id="@+id/aod_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_close"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Song Metadata Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="36dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/aod_song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soul Music"
                android:textColor="#EEEEEE"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/aod_song_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Artist"
                android:textColor="#777777"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Synced Lyrics 3-Line Vertical Stack -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/aod_lyric_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#33FFFFFF"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/aod_lyric_curr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end"
                android:paddingVertical="18dp" />

            <TextView
                android:id="@+id/aod_lyric_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#33FFFFFF"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Subtle Playback Controls -->
        <LinearLayout
            android:id="@+id/aod_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/aod_prev_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_skip"
                android:rotation="180" />

            <ImageView
                android:id="@+id/aod_play_pause_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="24dp"
                android:padding="8dp"
                android:src="@drawable/ic_pause" />

            <ImageView
                android:id="@+id/aod_next_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_skip" />
        </LinearLayout>

        <!-- Subtle Ambient Footer Hint -->
        <TextView
            android:id="@+id/aod_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/double_tap_to_exit"
            android:textColor="#33FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

</FrameLayout>

